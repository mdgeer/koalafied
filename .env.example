# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# Koalafied system prompt (optional — app reads system-prompt.txt at project root by default)
# Only needed if deploying without the system-prompt.txt file present.
# KOALAFIED_SYSTEM_PROMPT=

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Kit (ConvertKit) v4 API — use X-Kit-Api-Key header (not Bearer)
KIT_API_KEY=your-kit-api-key
KIT_FORM_ID=your-kit-form-id

# Admin bypass key — include X-Admin-Key: <value> header to skip rate limiting
KOALAFIED_ADMIN_KEY=your-admin-key

# Notification email for report failures
KOALAFIED_ALERT_EMAIL=your@email.com
